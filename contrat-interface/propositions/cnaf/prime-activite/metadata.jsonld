          "type": "eli:LegalResource",
          "title": "Code de la sécurité sociale",
          "dct:coverage": "Art. L. 841-1 et suivants (prime d'activité)"
        }
      ],

      "cv:hasChannel": { "id": "https://regles.data.gouv.fr/regles/cnaf/prime-activite/openfisca-france#channel" },

