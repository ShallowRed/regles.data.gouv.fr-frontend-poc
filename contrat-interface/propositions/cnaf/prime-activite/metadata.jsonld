          "cprmv:type": "xsd:decimal",
          "schema:valueRequired": true,
          "rdgf:factKind": "declared"
        },
        {
          "id": "https://regles.data.gouv.fr/regles/cnaf/prime-activite/openfisca-france#input-rfr",
