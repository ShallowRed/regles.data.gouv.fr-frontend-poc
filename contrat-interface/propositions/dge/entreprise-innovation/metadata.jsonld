          "dct:identifier": "natureActivite",
          "title": "Nature de l'activité",
          "cprmv:definition": "Activité commerciale, industrielle, agricole ou artisanale (conditionne l'éligibilité au CIR, art. 244 quater B).",
          "cprmv:type": "xsd:string",
          "schema:valueRequired": true,
          "rdgf:boundaryKind": "declaration"
        },
        {
          "id": "https://regles.data.gouv.fr/regles/dge/entreprise-innovation/v1#input-regimeFiscal",
          "type": ["cv:Evidence", "cprmv:Parameter"],
          "dct:identifier": "regimeFiscal",
          "title": "Régime fiscal",
          "cprmv:definition": "Imposition au régime réel ou condition d'exonération (art. 244 quater B).",
          "cprmv:type": "xsd:string",
          "schema:valueRequired": true,
          "rdgf:boundaryKind": "declaration"
        },
        {
