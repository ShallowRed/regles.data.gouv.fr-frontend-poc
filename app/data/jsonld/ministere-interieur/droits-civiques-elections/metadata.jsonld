{
  "@context": {
    "cpsv": "http://purl.org/vocab/cpsv#",
    "cv": "http://data.europa.eu/m8g/",
    "dct": "http://purl.org/dc/terms/",
    "eli": "http://data.europa.eu/eli/ontology#",
    "skos": "http://www.w3.org/2004/02/skos/core#",
    "schema": "http://schema.org/",
    "foaf": "http://xmlns.com/foaf/0.1/",
    "xsd": "http://www.w3.org/2001/XMLSchema#",
    "cprmv": "https://regels.overheid.nl/def/cprmv#",
    "px": "https://github.com/qloridant/regalgo-civique-droit-vote#vocab/",
    "id": "@id",
    "type": "@type",
    "title": { "@id": "dct:title", "@language": "fr" },
    "description": { "@id": "dct:description", "@language": "fr" }
  },
  "@graph": [
    {
      "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1",
      "type": "cpsv:PublicService",

      "dct:identifier": "civique.droit-vote.v1",
      "title": [
        { "@value": "Droit de vote en France", "@language": "fr" },
        { "@value": "Right to vote in France", "@language": "en" }
      ],
      "description": [
        { "@value": "Vérification algorithmique de l'éligibilité au droit de vote en France (élections nationales et municipales), codifiée en Python à partir du Code électoral et de la Constitution.", "@language": "fr" },
        { "@value": "Algorithmic check of eligibility for the right to vote in France (national and municipal elections), coded in Python from the Code électoral (French electoral code) and the Constitution.", "@language": "en" }
      ],
      "dct:version": "1.0.0",
      "dct:valid": "2024-01-01/",

      "cv:hasCompetentAuthority": { "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1#organisation" },

      "cv:hasLegalResource": [
        {
          "id": "https://www.legifrance.gouv.fr/codes/id/LEGITEXT000006070239/",
          "type": "eli:LegalResource",
          "title": [
            { "@value": "Code électoral", "@language": "fr" },
            { "@value": "Code électoral (French electoral code)", "@language": "en" }
          ],
          "dct:coverage": [
            { "@value": "Art. L.2 à L.7, L.O. 227-1", "@language": "fr" },
            { "@value": "Art. L.2 to L.7, L.O. 227-1", "@language": "en" }
          ]
        },
        {
          "id": "https://www.legifrance.gouv.fr/loda/article_lc/LEGIARTI000006527438/",
          "type": "eli:LegalResource",
          "title": [
            { "@value": "Constitution du 4 octobre 1958", "@language": "fr" },
            { "@value": "Constitution du 4 octobre 1958 (French Constitution)", "@language": "en" }
          ],
          "dct:coverage": "Art. 88-3"
        }
      ],

      "cv:hasChannel": { "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1#channel" },

      "dct:source": [
        { "id": "https://github.com/qloridant/regalgo-civique-droit-vote/blob/13d9f80ca21d47f55aef9710e6288e94ea10ccc6/src/regalgo_civique_droit_vote/algorithm.py" },
        { "id": "https://github.com/qloridant/regalgo-civique-droit-vote/blob/13d9f80ca21d47f55aef9710e6288e94ea10ccc6/tests/test_algorithm.py" }
      ],

      "cv:hasInput": [
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "nationalite_francaise",
          "dct:title": [
            { "@value": "Nationalité française", "@language": "fr" },
            { "@value": "French nationality", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "La personne a la nationalité française (Art. L.2). Pour les élections municipales, une nationalité UE combinée à citoyennete_ue+domicile_france peut aussi ouvrir droit (Art. 88-3 C°).", "@language": "fr" },
            { "@value": "The person holds French nationality (Art. L.2). For municipal elections, EU nationality combined with citoyennete_ue+domicile_france can also open the right (Art. 88-3 of the Constitution).", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean", "schema:valueRequired": true
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "age",
          "dct:title": [
            { "@value": "Âge", "@language": "fr" },
            { "@value": "Age", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "Âge de la personne en années révolues (Art. L.3 : doit être ≥ 18). Une valeur négative lève une erreur.", "@language": "fr" },
            { "@value": "Age of the person in completed years (Art. L.3: must be ≥ 18). A negative value raises an error.", "@language": "en" }
          ],
          "cprmv:type": "xsd:integer", "schema:valueRequired": true
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "capacite_civique",
          "dct:title": [
            { "@value": "Capacité civique", "@language": "fr" },
            { "@value": "Civic capacity", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "La personne n'est pas privée de ses droits civiques (Art. L.5, L.6).", "@language": "fr" },
            { "@value": "The person retains their civic rights (Art. L.5, L.6).", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean", "schema:valueRequired": true
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "inscrit_listes_electorales",
          "dct:title": [
            { "@value": "Inscription sur les listes électorales", "@language": "fr" },
            { "@value": "Registration on the electoral roll", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "La personne est inscrite sur les listes électorales (Art. L.7).", "@language": "fr" },
            { "@value": "The person is registered on the electoral roll (Art. L.7).", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean", "schema:valueRequired": true
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "citoyennete_ue",
          "dct:title": [
            { "@value": "Citoyenneté UE", "@language": "fr" },
            { "@value": "EU citizenship", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "La personne est citoyenne d'un État membre de l'UE. N'est prise en compte que pour les élections municipales (context.type_election = \"municipale\"), combinée à domicile_france.", "@language": "fr" },
            { "@value": "The person is a citizen of an EU member state. Taken into account for municipal elections only (context.type_election = \"municipale\"), combined with domicile_france.", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean", "schema:valueRequired": false, "schema:defaultValue": false
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "domicile_france",
          "dct:title": [
            { "@value": "Domicile en France", "@language": "fr" },
            { "@value": "Residence in France", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "La personne est domiciliée en France. Combinée à citoyennete_ue pour l'éligibilité aux élections municipales (Art. 88-3 C° / L.O. 227-1).", "@language": "fr" },
            { "@value": "The person resides in France. Combined with citoyennete_ue for eligibility in municipal elections (Art. 88-3 of the Constitution / L.O. 227-1).", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean", "schema:valueRequired": false, "schema:defaultValue": false
        },
        {
          "type": "cprmv:Parameter",
          "dct:identifier": "type_election",
          "dct:title": [
            { "@value": "Type d'élection", "@language": "fr" },
            { "@value": "Election type", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "Contexte d'exécution (paramètre 'context', pas 'data') : \"nationale\" (défaut) ou \"municipale\". Change la règle de nationalité appliquée.", "@language": "fr" },
            { "@value": "Execution context (parameter 'context' rather than 'data'): \"nationale\" (default) or \"municipale\". Changes the nationality rule applied.", "@language": "en" }
          ],
          "cprmv:type": "xsd:string", "schema:valueRequired": false, "schema:defaultValue": "nationale"
        }
      ],

      "cpsv:produces": [
        {
          "type": ["cv:Output", "cprmv:Rule"],
          "dct:identifier": "value",
          "dct:title": [
            { "@value": "Éligibilité au droit de vote", "@language": "fr" },
            { "@value": "Eligibility for the right to vote", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "Booléen : la personne a le droit de voter dans le contexte électoral demandé.", "@language": "fr" },
            { "@value": "Boolean: the person may vote in the requested electoral context.", "@language": "en" }
          ],
          "cprmv:type": "xsd:boolean"
        },
        {
          "type": ["cv:Output", "cprmv:Rule"],
          "dct:identifier": "metadata.conditions",
          "dct:title": [
            { "@value": "Détail des conditions évaluées", "@language": "fr" },
            { "@value": "Detail of the conditions evaluated", "@language": "en" }
          ],
          "cprmv:definition": [
            { "@value": "Trace structurée de chaque condition individuelle évaluée (éligible_nationalite, age_suffisant, capacite_civique, inscrit_listes_electorales, citoyennete_ue_avec_domicile_france) — utile pour expliquer un refus.", "@language": "fr" },
            { "@value": "Structured trace of each individual condition evaluated (éligible_nationalite, age_suffisant, capacite_civique, inscrit_listes_electorales, citoyennete_ue_avec_domicile_france), useful to explain a refusal.", "@language": "en" }
          ]
        }
      ],

      "dct:subject": ["election", "civique", "droit-vote", "code-electoral"]
    },

    {
      "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1#organisation",
      "type": "cv:PublicOrganisation",
      "skos:prefLabel": [
        { "@value": "Ministère de l'Intérieur", "@language": "fr" },
        { "@value": "Ministry of the Interior", "@language": "en" }
      ]
    },

    {
      "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1#channel",
      "type": "cv:Channel",
      "dct:identifier": "civique-droit-vote-channel-python",
      "dct:type": {
        "@type": "skos:Concept",
        "skos:prefLabel": [
          { "@value": "Bibliothèque logicielle (package Python)", "@language": "fr" },
          { "@value": "Software library (Python package)", "@language": "en" }
        ]
      },
      "dct:description": [
        { "@value": "Installation via pip. ATTENTION : le pyproject.toml référence test.pypi.org comme source — le package semble n'être publié qu'en environnement de test, pas sur PyPI officiel.", "@language": "fr" },
        { "@value": "Installation with pip. Warning: pyproject.toml references test.pypi.org as its source, so the package appears to be published on the test environment only, not on the official PyPI.", "@language": "en" }
      ],
      "foaf:page": { "id": "https://github.com/qloridant/regalgo-civique-droit-vote" },
      "cv:ownedBy": { "id": "https://regles.gouv.fr/algo/civique/droit-vote/v1#organisation" }
    },

    {
      "id": "https://github.com/qloridant/regalgo-civique-droit-vote#source-code",
      "type": "schema:SoftwareSourceCode",
      "schema:name": "regalgo-civique-droit-vote",
      "schema:description": [
        { "@value": "Package Python implémentant l'éligibilité au droit de vote en France, avec deux modes d'appel : AlgoInput (données brutes) ou PersonInput (aligné sur Core Person Vocabulary / CCCEV — cv_nationality, schema_birth_date, cccev_civil_rights_intact, cccev_electoral_list_registered, cv_domicile_country). Fait partie de l'écosystème 'regalgo' d'algorithmes réglementaires.", "@language": "fr" },
        { "@value": "Python package implementing eligibility for the right to vote in France, with two call modes: AlgoInput (raw data) or PersonInput (aligned with the Core Person Vocabulary / CCCEV: cv_nationality, schema_birth_date, cccev_civil_rights_intact, cccev_electoral_list_registered, cv_domicile_country). Part of the 'regalgo' ecosystem of regulatory algorithms.", "@language": "en" }
      ],
      "schema:codeRepository": "https://github.com/qloridant/regalgo-civique-droit-vote/tree/13d9f80ca21d47f55aef9710e6288e94ea10ccc6",
      "schema:programmingLanguage": "Python",
      "schema:runtimePlatform": "Python >= 3.10 (build Poetry)",
      "schema:softwareRequirements": ["regalgo ^0.0 (paquet partagé de l'écosystème regalgo : AlgoInput, AlgoResult, PersonInput)"],
      "schema:softwareVersion": "1.0.4",
      "px:howTo": {
        "@type": "schema:HowTo",
        "schema:name": "Installer et tester regalgo-civique-droit-vote",
        "schema:step": [
          { "@type": "schema:HowToStep", "schema:name": "Installer le package", "schema:text": "pip install regalgo-civique-droit-vote  # publié sur test.pypi.org d'après pyproject.toml" },
          { "@type": "schema:HowToStep", "schema:name": "Lancer les tests", "schema:text": "pytest" },
          { "@type": "schema:HowToStep", "schema:name": "Utiliser en Python (entrée brute)", "schema:text": "from regalgo_civique_droit_vote import DroitVoteAlgorithm\nfrom regalgo import AlgoInput\nalgo = DroitVoteAlgorithm()\nresult = algo.compute(AlgoInput(data={'nationalite_francaise': True, 'age': 25, 'capacite_civique': True, 'inscrit_listes_electorales': True}))" }
        ]
      }
    }
  ]
}